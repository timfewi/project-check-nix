#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
if [[ "${1:-}" != fast || "$#" -ne 1 ]]; then
  echo "Usage: bash scripts/check fast" >&2
  exit 2
fi
just --fmt --check
mapfile -d '' -t nix_files < <(git ls-files --cached --others --exclude-standard -z -- '*.nix')
nix fmt --no-write-lock-file -- --check "${nix_files[@]}"
# Git-backed sources exclude ignored caches and build output from the store.
# New source files must be tracked (intent-to-add is sufficient) before checking.
nix flake check --all-systems --no-write-lock-file --no-build .
project_check_system="$(nix eval --impure --raw --expr builtins.currentSystem)"
exec nix build --no-link --max-jobs 1 --cores 2 --no-write-lock-file \
  ".#checks.$project_check_system.rust-tests"
