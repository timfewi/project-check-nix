{
  "version": 2,
  "warnings": "fail",
  "checks": [{
    "name": "project-check-fast",
    "argv": ["bash", "scripts/check", "fast"],
    "requires": ["bash", "git", "nix"],
    "input_paths": ["src/", "Cargo.toml", "Cargo.lock", "tests/", "scripts/", "packages/", "flake.nix", "flake.lock", ".project-checks.json"],
    "timeout_seconds": 1800,
    "profiles": ["fast"]
  }]
}
